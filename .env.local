# --- Shopify (already in your .env.local) ---
# --- Already in your .env.local ---
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=myfirstnight.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=f1ee32517e4172ecd0d71ecb05607a3c
SHOPIFY_GRAPHQL_API_VERSION="2024-01"


# --- New ---
NEXT_PUBLIC_SITE_URL=https://myfirstnight.in
NEXT_PUBLIC_WHATSAPP_NUMBER=917009646377     # digits only, with country code
NEXT_PUBLIC_CONTACT_EMAIL=care@myfirstnight.in
NEXT_PUBLIC_CONTACT_PHONE=+91 7009646377
NEXT_PUBLIC_LEGAL_NAME=MyFirstNight                 # registered business name shown in Terms
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=3000           # e.g. 3000; leave empty to hide the progress bar

# Newsletter -> Shopify customers (server-only; create a custom app with write_customers)
SHOPIFY_ADMIN_ACCESS_TOKEN=f1ee32517e4172ecd0d71ecb05607a3c
SHOPIFY_ADMIN_DOMAIN=your-store.myshopify.com
WELCOME_DISCOUNT_CODE= FN10                        # a code you created in Shopify Admin > Discounts


# --- Tracking (nothing loads until the visitor accepts cookies) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=1945241539454796
NEXT_PUBLIC_META_CAPI=true                     # also send events server-side
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=                          # only while testing

# --- Pincode / COD / delivery estimate (Shiprocket) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=                           # use a dedicated API user, not your main login
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_DEFAULT_WEIGHT=0.5







# --- Gift builder bundle privilege (optional) ---
# Create a discount code in Shopify (e.g. min. 2 items) and enter it here.
NEXT_PUBLIC_GIFT_BUNDLE_CODE=
NEXT_PUBLIC_GIFT_BUNDLE_LABEL=                 # e.g. "10% off"

# --- "Email me my bag" (Resend) ---
RESEND_API_KEY=
RESEND_FROM="MyFirstNight <care@your-verified-domain.com>"

# --- Hero video (optional; see SETUP.md for encoding) ---
NEXT_PUBLIC_HERO_VIDEO_URL=                    # e.g. /hero.mp4 (put the file in /public) or a CDN URL
NEXT_PUBLIC_HERO_VIDEO_MOBILE_URL=             # smaller/portrait version for phones
NEXT_PUBLIC_JOURNAL_BLOG_HANDLE=               # optional: show only this Shopify blog (default: all blogs)
REVALIDATE_SECRET=                             # long random string; enables /api/revalidate and /api/shopify-check
